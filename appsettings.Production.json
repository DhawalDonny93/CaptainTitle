{
  "ConnectionStrings": {
    "DefaultConnection": "#{ConnectionString}#"
  },
  "Supabase": {
    "Url": "#{SupabaseUrl}#",
    "Key": "#{SupabaseKey}#"
  },
  "Google": {
    "ClientId": "#{GoogleClientId}#",
    "ClientSecret": "#{GoogleClientSecret}#",
    "RedirectUri": "#{GoogleRedirectUri}#"
  },
  "Twilio": {
    "AccountSid": "#{TwilioAccountSid}#",
    "AuthToken": "#{TwilioAuthToken}#",
    "FromPhoneNumber": "#{TwilioFromPhone}#"
  },
  "SendGrid": {
    "ApiKey": "#{SendGridApiKey}#",
    "FromEmail": "#{SendGridFromEmail}#",
    "FromName": "#{AppName}#"
  },
  "Razorpay": {
    "KeyId": "#{RazorpayKeyId}#",
    "KeySecret": "#{RazorpayKeySecret}#",
    "WebhookSecret": "#{RazorpayWebhookSecret}#"
  },
  "AppUrl": "#{ProductionAppUrl}#",
  "Apple": {
    "ClientId": "#{AppleClientId}#",
    "AllowedAudiences": [
      "#{AppleClientId}#"
    ]
  },
  "JWT": {
    "Secret": "#{JWTSecret}#",
    "Issuer": "#{CompanyName}#",
    "Audience": "#{AppName}Users#",
    "ExpirationMinutes": "60",
    "RefreshTokenExpirationDays": "7"
  },
  "AccountLockout": {
    "MaxFailedAttempts": 5,
    "LockoutDurationMinutes": 30
  },
  "Session": {
    "IdleTimeoutMinutes": 30,
    "AbsoluteTimeoutMinutes": 480,
    "SlidingExpiration": true
  },
  "AccountDeletion": {
    "GracePeriodDays": 30
  },
  "DataExport": {
    "Directory": "#{DataExportDirectory}#",
    "ExpirationHours": 24
  },
  "APNs": {
    "KeyId": "#{APNsKeyId}#",
    "TeamId": "#{APNsTeamId}#",
    "BundleId": "#{APNsBundleId}#",
    "KeyPath": "#{APNsKeyPath}#",
    "UseSandbox": false
  },
  "PhotoUpload": {
    "Directory": "#{PhotoUploadDirectory}#"
  },
  "RateLimiting": {
    "EnableIpRateLimiting": true,
    "IpWhitelist": [],
    "GeneralRules": {
      "Endpoint": "*",
      "Period": "1m",
      "Limit": 60
    },
    "EndpointRules": [
      {
        "Endpoint": "POST:/api/auth/login",
        "Period": "1m",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/auth/register",
        "Period": "1m",
        "Limit": 2
      },
      {
        "Endpoint": "POST:/api/auth/send-otp",
        "Period": "1h",
        "Limit": 3
      },
      {
        "Endpoint": "POST:/api/auth/verify-otp",
        "Period": "1h",
        "Limit": 5
      },
      {
        "Endpoint": "POST:/api/auth/forgot-password",
        "Period": "1h",
        "Limit": 2
      },
      {
        "Endpoint": "POST:/api/auth/reset-password",
        "Period": "1h",
        "Limit": 2
      }
    ]
  },
  "AppStore": {
    "SharedSecret": "#{AppStoreSharedSecret}#",
    "Environment": "Production"
  },
  "GooglePlay": {
    "ServiceAccountKeyPath": "#{GooglePlayKeyPath}#",
    "PackageName": "#{GooglePlayPackageName}#"
  },
  "RevenueCat": {
    "ApiKey": "#{RevenueCatApiKey}#",
    "WebhookAuthToken": "#{RevenueCatWebhookToken}#",
    "ProxyUrl": "https://api.revenuecat.com/v1"
  },
  "AdminSeed": {
    "Email": "#{AdminEmail}#",
    "Password": "#{AdminPassword}#",
    "FirstName": "Admin",
    "LastName": "User"
  },
  "Encryption": {
    "Key": "#{EncryptionKey}#"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Error",
      "System": "Error"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Warning",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Error",
        "System": "Error"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/appbackend/app-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 90,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  },
  "ApplicationInsights": {
    "ConnectionString": "#{AppInsightsConnectionString}#"
  },
  "Redis": {
    "ConnectionString": "#{RedisConnectionString}#",
    "InstanceName": "#{AppName}_",
    "Enabled": true
  },
  "OpenAI": {
    "ApiKey": "#{OpenAIApiKey}#",
    "DefaultModel": "gpt-4o",
    "MaxTokens": 1000,
    "Temperature": 0.7
  },
  "LlmQuotas": {
    "Free": {
      "RequestsPerMonth": 100,
      "TokensPerMonth": 100000,
      "ImagesPerMonth": 50,
      "RequestsPerMinute": 10,
      "RequestsPerHour": 100,
      "RequestsPerDay": 500
    },
    "Premium": {
      "RequestsPerMonth": 10000,
      "TokensPerMonth": 1000000,
      "ImagesPerMonth": 500,
      "RequestsPerMinute": 60,
      "RequestsPerHour": 1000,
      "RequestsPerDay": 5000
    }
  }
}
