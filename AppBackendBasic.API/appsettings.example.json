{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=YOUR_DB_HOST;Database=YOUR_DB_NAME;Username=YOUR_DB_USER;Password=YOUR_DB_PASSWORD"
  },
  "JWT": {
    "Secret": "YOUR_JWT_SECRET_KEY_MINIMUM_32_CHARACTERS_LONG",
    "Issuer": "YourAppName",
    "Audience": "YourAppName",
    "ExpirationMinutes": 60
  },
  "GoogleAuth": {
    "ClientId": "YOUR_GOOGLE_CLIENT_ID",
    "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
  },
  "AppleAuth": {
    "ClientId": "YOUR_APPLE_CLIENT_ID",
    "TeamId": "YOUR_APPLE_TEAM_ID",
    "KeyId": "YOUR_APPLE_KEY_ID",
    "PrivateKey": "YOUR_APPLE_PRIVATE_KEY_PATH"
  },
  "OpenAI": {
    "ApiKey": "YOUR_OPENAI_API_KEY"
  },
  "Anthropic": {
    "ApiKey": "YOUR_ANTHROPIC_API_KEY"
  },
  "GoogleGemini": {
    "ApiKey": "YOUR_GOOGLE_GEMINI_API_KEY"
  },
  "DeepSeek": {
    "ApiKey": "YOUR_DEEPSEEK_API_KEY"
  },
  "Twilio": {
    "AccountSid": "YOUR_TWILIO_ACCOUNT_SID",
    "AuthToken": "YOUR_TWILIO_AUTH_TOKEN",
    "PhoneNumber": "YOUR_TWILIO_PHONE_NUMBER"
  },
  "EmailSettings": {
    "SmtpServer": "smtp.your-email-provider.com",
    "SmtpPort": 587,
    "SmtpUsername": "YOUR_SMTP_USERNAME",
    "SmtpPassword": "YOUR_SMTP_PASSWORD",
    "FromEmail": "noreply@yourdomain.com",
    "FromName": "Your App Name"
  },
  "Azure": {
    "BlobStorage": {
      "ConnectionString": "YOUR_AZURE_STORAGE_CONNECTION_STRING",
      "ContainerName": "your-container-name"
    }
  },
  "Redis": {
    "ConnectionString": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Stripe": {
    "SecretKey": "YOUR_STRIPE_SECRET_KEY",
    "WebhookSecret": "YOUR_STRIPE_WEBHOOK_SECRET"
  },
  "Captions": {
    "StorageRoot": "App_Data/caption_storage",
    "FontsDir": "Assets/captions/fonts",
    "FfmpegPath": "ffmpeg",
    "MaxConcurrentJobs": 2,
    "MediaTokenMinutes": 120,
    "SarvamApiKey": "YOUR_SARVAM_API_KEY",
    "OpenAiApiKey": "",
    "StripeWebhookSecret": "",
    "ReturnOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:5173",
      "https://yourdomain.com"
    ]
  }
}
