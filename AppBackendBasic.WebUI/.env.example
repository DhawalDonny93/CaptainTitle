# ============================================
# API CONFIGURATION
# ============================================
# IMPORTANT: This is the base URL for your backend API
# Development: Use localhost
# Production: Use your deployed API domain
VITE_API_URL=http://localhost:5082/api

# Production example:
# VITE_API_URL=https://your-api-domain.com/api

# ============================================
# OAUTH CLIENT IDs (Public - safe in frontend)
# ============================================
# These are PUBLIC client IDs and are safe to expose in frontend code
# Get these from your OAuth provider's developer console

# GitHub OAuth
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ============================================
# APP CONFIGURATION
# ============================================
VITE_APP_NAME=Your SaaS App
VITE_APP_URL=http://localhost:5173

# Production example:
# VITE_APP_URL=https://yourdomain.com

# ============================================
# OAUTH FLOW NOTES
# ============================================
# Google OAuth Configuration:
# - Client-side flow (popup): Uses VITE_GOOGLE_CLIENT_ID above
# - Server-side flow: API backend handles OAuth and redirects to callback URL
# - Callback URL format: [Site Domain URL]/auth/google/callback?accessToken=[AccessToken]&refreshToken=[RefreshToken]
#
# Setup Instructions:
# 1. Create OAuth app in Google Cloud Console
# 2. Add authorized redirect URIs:
#    - Development: http://localhost:5173/auth/google/callback
#    - Production: https://yourdomain.com/auth/google/callback
# 3. Copy Client ID to VITE_GOOGLE_CLIENT_ID above
# 4. Add Client Secret to backend appsettings.json (NOT here!)
