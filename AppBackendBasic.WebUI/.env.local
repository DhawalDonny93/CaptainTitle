# API Configuration
VITE_API_URL=/api
# Vite dev server forwards /api here, so the browser only talks to localhost (no CORS)
VITE_DEV_PROXY_TARGET=https://captaintitle.runasp.net

# OAuth Client IDs
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# App Configuration
VITE_APP_NAME=AI SEO Platform
VITE_APP_URL=http://localhost:5173
