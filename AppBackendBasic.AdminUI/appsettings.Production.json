{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ApiSettings": {
    "BaseUrl": "https://captaintitle.netlify.app",
    "Timeout": 30
  },
  "Authentication": {
    "CookieName": "AdminAuth",
    "LoginPath": "/Login",
    "LogoutPath": "/Logout",
    "AccessDeniedPath": "/AccessDenied",
    "ExpireTimeSpan": 60
  },
  "Security": {
    "RequireHttps": true,
    "EnableHsts": true,
    "HstsMaxAge": 31536000
  }
}
