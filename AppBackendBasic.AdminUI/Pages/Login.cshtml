@page
@model AppBackendBasic.AdminUI.Pages.LoginModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Admin Login - Captain Title</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <style>
        /* Captain Title palette over Bootstrap: bright, flat, no blue/purple, no gradients */
        :root { --bs-primary:#FF2D4D; --bs-primary-rgb:255,45,77; --bs-link-color:#E01E3F; --bs-link-hover-color:#14110F; --bs-body-bg:#FFF8E7; }
        .btn-primary { --bs-btn-bg:#FF2D4D; --bs-btn-border-color:#14110F; --bs-btn-color:#fff; --bs-btn-hover-bg:#E01E3F; --bs-btn-hover-border-color:#14110F; --bs-btn-hover-color:#fff; --bs-btn-active-bg:#E01E3F; --bs-btn-active-border-color:#14110F; --bs-btn-active-color:#fff; --bs-btn-disabled-bg:#FF2D4D; --bs-btn-disabled-border-color:#14110F; --bs-btn-focus-shadow-rgb:255,45,77; }
        .btn-outline-primary { --bs-btn-color:#E01E3F; --bs-btn-border-color:#E01E3F; --bs-btn-hover-bg:#FF2D4D; --bs-btn-hover-border-color:#FF2D4D; --bs-btn-hover-color:#fff; --bs-btn-active-bg:#FF2D4D; --bs-btn-active-border-color:#FF2D4D; --bs-btn-active-color:#fff; }
        .bg-primary { background-color:#FF2D4D !important; } .text-primary { color:#E01E3F !important; } .border-primary { border-color:#FF2D4D !important; }
        .bg-info { background-color:#FF8A00 !important; color:#14110F !important; } .text-info { color:#C46A00 !important; }
        .form-check-input:checked { background-color:#FF2D4D; border-color:#FF2D4D; } .form-control:focus, .form-select:focus { border-color:#FF2D4D; box-shadow:0 0 0 .2rem rgba(255,45,77,.25); }

        body {
            background: #FFF8E7;
            min-height: 100vh;
        }
        .login-card {
            border-radius: 15px;
            box-shadow: 6px 6px 0 #14110F; border: 2px solid #14110F;
        }
        .login-header {
            background: #FF2D4D;
            color: white;
            border-radius: 15px 15px 0 0;
            padding: 30px;
            text-align: center;
        }
        .login-body {
            padding: 40px;
        }
        .btn-login {
            background: #FF2D4D;
            border: none;
            padding: 12px;
            font-weight: 600;
        }
        .btn-login:hover {
            opacity: 0.9;
            transform: translateY(-2px);
            transition: all 0.3s;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-100">
            <div class="col-md-5 col-lg-4">
                <div class="card login-card border-0">
                    <div class="login-header">
                        <i class="fas fa-shield-alt fa-3x mb-3"></i>
                        <h3 class="mb-0">Admin</h3>
                        <p class="mb-0 mt-2 opacity-75">Captain Title Backend</p>
                    </div>
                    <div class="login-body">
                        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                        {
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                @Model.ErrorMessage
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        }
                        
                        <form method="post">
                            <div class="mb-4">
                                <label asp-for="Email" class="form-label">
                                    <i class="fas fa-envelope me-2"></i>Email Address
                                </label>
                                <input asp-for="Email" 
                                       class="form-control form-control-lg" 
                                       placeholder="admin@example.com"
                                       required 
                                       autofocus />
                            </div>
                            
                            <div class="mb-4">
                                <label asp-for="Password" class="form-label">
                                    <i class="fas fa-lock me-2"></i>Password
                                </label>
                                <input asp-for="Password" 
                                       type="password" 
                                       class="form-control form-control-lg" 
                                       placeholder="Enter your password"
                                       required />
                            </div>
                            
                            <button type="submit" class="btn btn-primary btn-login w-100 btn-lg">
                                <i class="fas fa-sign-in-alt me-2"></i>Login to Dashboard
                            </button>
                        </form>
                        
                        <div class="text-center mt-4">
                            <small class="text-muted">
                                <i class="fas fa-info-circle me-1"></i>
                                Default: admin@yourapp.com / Admin@123456
                            </small>
                        </div>
                    </div>
                </div>
                
                <div class="text-center mt-4">
                    <p class="text-white">
                        <i class="fas fa-code me-2"></i>
                        Captain Title Backend v1.0
                    </p>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
