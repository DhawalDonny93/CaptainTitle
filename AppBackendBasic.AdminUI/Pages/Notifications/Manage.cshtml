@page
@model AppBackendBasic.AdminUI.Pages.Notifications.ManageModel
@{
    ViewData["Title"] = "Manage Web Notifications";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Web Notifications</h2>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createNotificationModal">
            <i class="bi bi-plus-circle"></i> Create Notification
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Type</th>
                            <th>Title</th>
                            <th>Message</th>
                            <th>Target</th>
                            <th>Created</th>
                            <th>Expires</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Notifications?.Any() == true)
                        {
                            @foreach (var notification in Model.Notifications)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-@GetBadgeClass(notification.Type)">
                                            @notification.Type
                                        </span>
                                    </td>
                                    <td>@notification.Title</td>
                                    <td>@notification.Body</td>
                                    <td>
                                        @if (notification.IsGlobal)
                                        {
                                            <span class="badge bg-info">Global</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">User #@notification.UserId</span>
                                        }
                                    </td>
                                    <td>@notification.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                    <td>
                                        @if (notification.ExpiresAt.HasValue)
                                        {
                                            @notification.ExpiresAt.Value.ToString("MMM dd, yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span class="text-muted">Never</span>
                                        }
                                    </td>
                                    <td>
                                        <form method="post" asp-page-handler="Delete" asp-route-id="@notification.Id" 
                                              onsubmit="return confirm('Are you sure you want to delete this notification?');" 
                                              style="display: inline;">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted py-4">
                                    <i class="bi bi-bell-slash fs-1 d-block mb-2"></i>
                                    No notifications found
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Create Notification Modal -->
<div class="modal fade" id="createNotificationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="Create">
                <div class="modal-header">
                    <h5 class="modal-title">Create Web Notification</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Type <span class="text-danger">*</span></label>
                        <select class="form-select" name="Type" required>
                            <option value="success">Success</option>
                            <option value="error">Error</option>
                            <option value="warning">Warning</option>
                            <option value="info" selected>Info</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Title</label>
                        <input type="text" class="form-control" name="Title" maxlength="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Message <span class="text-danger">*</span></label>
                        <textarea class="form-control" name="Message" rows="3" required></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Target</label>
                        <select class="form-select" name="IsGlobal" id="targetSelect" onchange="toggleUserIdField()">
                            <option value="true">All Users (Global)</option>
                            <option value="false">Specific User</option>
                        </select>
                    </div>

                    <div class="mb-3" id="userIdField" style="display: none;">
                        <label class="form-label">User ID</label>
                        <input type="number" class="form-control" name="UserId" min="1" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Duration (milliseconds)</label>
                        <input type="number" class="form-control" name="DurationMs" value="5000" min="1000" />
                        <small class="form-text text-muted">Default: 5000ms (5 seconds)</small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Action URL</label>
                        <input type="text" class="form-control" name="ActionUrl" placeholder="/dashboard" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Action Text</label>
                        <input type="text" class="form-control" name="ActionText" placeholder="View Details" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Expires At</label>
                        <input type="datetime-local" class="form-control" name="ExpiresAt" />
                    </div>

                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsDismissible" checked id="dismissibleCheck" />
                        <label class="form-check-label" for="dismissibleCheck">
                            Dismissible
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create Notification</button>
                </div>
            </form>
        </div>
    </div>
</div>

@functions {
    private string GetBadgeClass(string type)
    {
        return type?.ToLower() switch
        {
            "success" => "success",
            "error" => "danger",
            "warning" => "warning",
            "info" => "info",
            _ => "secondary"
        };
    }
}

@section Scripts {
    <script>
        function toggleUserIdField() {
            const select = document.getElementById('targetSelect');
            const userIdField = document.getElementById('userIdField');
            userIdField.style.display = select.value === 'false' ? 'block' : 'none';
        }
    </script>
}
