@page
@model AppBackendBasic.AdminUI.Pages.Onboarding.IndexModel
@{
    ViewData["Title"] = "Onboarding Management";
}

<style>
    .step-card {
        border-left: 4px solid var(--primary-color);
        transition: all 0.3s ease;
        cursor: pointer;
    }
    .step-card:hover {
        transform: translateX(4px);
        box-shadow: var(--card-shadow-hover);
    }
    .step-card.inactive {
        opacity: 0.6;
        border-left-color: var(--text-secondary);
    }
    .question-badge {
        background: rgba(99, 102, 241, 0.1);
        color: var(--primary-color);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .drag-handle {
        cursor: move;
        color: var(--text-secondary);
        opacity: 0;
        transition: opacity 0.2s;
    }
    .step-card:hover .drag-handle {
        opacity: 1;
    }
    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.2s;
    }
    .action-btn:hover {
        transform: scale(1.1);
    }
    .modal-header {
        background: #FF2D4D;
        color: white;
        border-radius: 16px 16px 0 0;
    }
    .form-label {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 8px;
    }
    .form-control, .form-select {
        border-radius: 10px;
        border: 1px solid var(--border-color);
        padding: 10px 14px;
    }
    .form-control:focus, .form-select:focus {
        border-color: var(--primary-color);
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .stats-card {
        background: #FF2D4D;
        border-radius: 12px;
        padding: 16px;
        border: 1px solid rgba(99, 102, 241, 0.1);
    }
    .sortable-ghost {
        opacity: 0.4;
        background: #f8f9fa;
    }
</style>

<!-- Header with Actions -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="mb-1" style="font-weight: 700; color: var(--text-primary);">
            <i class="fas fa-clipboard-list me-2" style="color: var(--primary-color);"></i>
            Onboarding Management
        </h2>
        <p class="text-muted mb-0">Manage onboarding steps and questions for new users</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="showCreateStepModal()" style="border-radius: 10px; padding: 10px 20px;">
            <i class="fas fa-plus me-2"></i>Create Step
        </button>
        <button class="btn btn-outline-secondary ms-2" onclick="viewStatistics()" style="border-radius: 10px; padding: 10px 20px;">
            <i class="fas fa-chart-bar me-2"></i>Statistics
        </button>
    </div>
</div>

<!-- Statistics Cards -->
<div class="row g-3 mb-4">
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); font-weight: 600;">TOTAL STEPS</div>
                    <div style="font-size: 24px; font-weight: 700; color: var(--primary-color);" id="totalSteps">0</div>
                </div>
                <i class="fas fa-layer-group fa-2x" style="color: var(--primary-color); opacity: 0.3;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); font-weight: 600;">ACTIVE STEPS</div>
                    <div style="font-size: 24px; font-weight: 700; color: var(--success-color);" id="activeSteps">0</div>
                </div>
                <i class="fas fa-check-circle fa-2x" style="color: var(--success-color); opacity: 0.3;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); font-weight: 600;">TOTAL QUESTIONS</div>
                    <div style="font-size: 24px; font-weight: 700; color: var(--info-color);" id="totalQuestions">0</div>
                </div>
                <i class="fas fa-question-circle fa-2x" style="color: var(--info-color); opacity: 0.3;"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="stats-card">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <div style="font-size: 12px; color: var(--text-secondary); font-weight: 600;">COMPLETION RATE</div>
                    <div style="font-size: 24px; font-weight: 700; color: var(--warning-color);" id="completionRate">0%</div>
                </div>
                <i class="fas fa-percentage fa-2x" style="color: var(--warning-color); opacity: 0.3;"></i>
            </div>
        </div>
    </div>
</div>

<!-- Filter Options -->
<div class="card mb-4">
    <div class="card-body">
        <div class="row align-items-center">
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="showInactive" onchange="loadSteps()">
                    <label class="form-check-label" for="showInactive">
                        Show Inactive Steps
                    </label>
                </div>
            </div>
            <div class="col-md-6 text-end">
                <button class="btn btn-sm btn-outline-primary" onclick="reorderMode()" id="reorderBtn">
                    <i class="fas fa-arrows-alt me-1"></i>Reorder Steps
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Steps List -->
<div id="stepsList" class="row g-4">
    <!-- Steps will be loaded here -->
</div>

<!-- Create/Edit Step Modal -->
<div class="modal fade" id="stepModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header">
                <h5 class="modal-title" id="stepModalTitle">
                    <i class="fas fa-plus-circle me-2"></i>Create Onboarding Step
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="stepForm">
                    <input type="hidden" id="stepId">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="stepKey" class="form-label">Step Key *</label>
                            <input type="text" class="form-control" id="stepKey" required placeholder="e.g., basic_info">
                            <small class="text-muted">Unique identifier (lowercase, underscores only)</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="stepName" class="form-label">Step Name *</label>
                            <input type="text" class="form-control" id="stepName" required placeholder="e.g., Basic Information">
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" rows="2" placeholder="Describe this onboarding step..."></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="displayOrder" class="form-label">Display Order *</label>
                            <input type="number" class="form-control" id="displayOrder" required min="1" value="1">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Required Step?</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isRequired" checked>
                                <label class="form-check-label" for="isRequired">Yes</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Active?</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label" for="isActive">Yes</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveStep()">
                    <i class="fas fa-save me-2"></i>Save Step
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Statistics Modal -->
<div class="modal fade" id="statisticsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="fas fa-chart-bar me-2"></i>Onboarding Statistics
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4" id="statisticsContent">
                <!-- Statistics will be loaded here -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        const API_BASE = '@Model.ApiBaseUrl';
        const JWT_TOKEN = '@Model.JwtToken';
        let currentSteps = [];
        let stepModal, statisticsModal;

        document.addEventListener('DOMContentLoaded', function() {
            stepModal = new bootstrap.Modal(document.getElementById('stepModal'));
            statisticsModal = new bootstrap.Modal(document.getElementById('statisticsModal'));
            loadSteps();
            loadStatistics();
        });

        async function loadSteps() {
            const showInactive = document.getElementById('showInactive').checked;
            const response = await fetch(`${API_BASE}/api/admin/onboarding/steps?includeInactive=${showInactive}`, {
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });
            
            if (response.ok) {
                const data = await response.json();
                currentSteps = data.data;
                renderSteps(currentSteps);
                updateStats(currentSteps);
            }
        }

        function renderSteps(steps) {
            const container = document.getElementById('stepsList');
            if (steps.length === 0) {
                container.innerHTML = `
                    <div class="col-12">
                        <div class="card text-center p-5">
                            <i class="fas fa-clipboard-list fa-4x text-muted mb-3"></i>
                            <h5>No Onboarding Steps</h5>
                            <p class="text-muted">Create your first onboarding step to get started</p>
                            <button class="btn btn-primary mt-2" onclick="showCreateStepModal()">
                                <i class="fas fa-plus me-2"></i>Create Step
                            </button>
                        </div>
                    </div>
                `;
                return;
            }

            container.innerHTML = steps.map(step => `
                <div class="col-md-6">
                    <div class="card step-card ${!step.isActive ? 'inactive' : ''}" data-step-id="${step.id}">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <div class="drag-handle me-3">
                                    <i class="fas fa-grip-vertical fa-lg"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1" style="font-weight: 600;">
                                                ${step.stepName}
                                                ${!step.isActive ? '<span class="badge bg-secondary ms-2">Inactive</span>' : ''}
                                                ${step.isRequired ? '<span class="badge bg-warning ms-2">Required</span>' : ''}
                                            </h5>
                                            <small class="text-muted">Key: ${step.stepKey}</small>
                                        </div>
                                        <span class="question-badge">${step.questionCount} Questions</span>
                                    </div>
                                    <p class="text-muted mb-3" style="font-size: 14px;">${step.description || 'No description'}</p>
                                    <div class="d-flex gap-2">
                                        <button class="action-btn" style="background: rgba(99, 102, 241, 0.1); color: var(--primary-color);" 
                                                onclick="viewQuestions('${step.id}')" title="View Questions">
                                            <i class="fas fa-list"></i>
                                        </button>
                                        <button class="action-btn" style="background: rgba(16, 185, 129, 0.1); color: var(--success-color);" 
                                                onclick="editStep('${step.id}')" title="Edit Step">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger-color);" 
                                                onclick="deleteStep('${step.id}')" title="Delete Step">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function updateStats(steps) {
            const totalQuestions = steps.reduce((sum, step) => sum + step.questionCount, 0);
            const activeSteps = steps.filter(s => s.isActive).length;
            
            document.getElementById('totalSteps').textContent = steps.length;
            document.getElementById('activeSteps').textContent = activeSteps;
            document.getElementById('totalQuestions').textContent = totalQuestions;
        }

        async function loadStatistics() {
            const response = await fetch(`${API_BASE}/api/admin/onboarding/statistics`, {
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });
            
            if (response.ok) {
                const data = await response.json();
                document.getElementById('completionRate').textContent = data.data.completionRate.toFixed(1) + '%';
            }
        }

        function showCreateStepModal() {
            document.getElementById('stepModalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Create Onboarding Step';
            document.getElementById('stepForm').reset();
            document.getElementById('stepId').value = '';
            document.getElementById('isRequired').checked = true;
            document.getElementById('isActive').checked = true;
            stepModal.show();
        }

        async function editStep(stepId) {
            const step = currentSteps.find(s => s.id === stepId);
            if (!step) return;

            document.getElementById('stepModalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Onboarding Step';
            document.getElementById('stepId').value = step.id;
            document.getElementById('stepKey').value = step.stepKey;
            document.getElementById('stepName').value = step.stepName;
            document.getElementById('description').value = step.description || '';
            document.getElementById('displayOrder').value = step.displayOrder;
            document.getElementById('isRequired').checked = step.isRequired;
            document.getElementById('isActive').checked = step.isActive;
            
            stepModal.show();
        }

        async function saveStep() {
            const stepId = document.getElementById('stepId').value;
            const isEdit = stepId !== '';
            
            const stepData = {
                stepKey: document.getElementById('stepKey').value,
                stepName: document.getElementById('stepName').value,
                description: document.getElementById('description').value,
                displayOrder: parseInt(document.getElementById('displayOrder').value),
                isRequired: document.getElementById('isRequired').checked,
                isActive: document.getElementById('isActive').checked
            };

            if (isEdit) {
                stepData.id = stepId;
            }

            const url = isEdit 
                ? `${API_BASE}/api/admin/onboarding/steps/${stepId}`
                : `${API_BASE}/api/admin/onboarding/steps`;
            
            const method = isEdit ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${JWT_TOKEN}`
                },
                body: JSON.stringify(stepData)
            });

            if (response.ok) {
                stepModal.hide();
                loadSteps();
                showToast('Success', `Step ${isEdit ? 'updated' : 'created'} successfully`, 'success');
            } else {
                const error = await response.json();
                showToast('Error', error.message || 'Failed to save step', 'danger');
            }
        }

        async function deleteStep(stepId) {
            if (!confirm('Are you sure you want to delete this step? This will soft-delete it.')) return;

            const response = await fetch(`${API_BASE}/api/admin/onboarding/steps/${stepId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });

            if (response.ok) {
                loadSteps();
                showToast('Success', 'Step deleted successfully', 'success');
            } else {
                showToast('Error', 'Failed to delete step', 'danger');
            }
        }

        function viewQuestions(stepId) {
            window.location.href = `/Onboarding/Questions?stepId=${stepId}`;
        }

        async function viewStatistics() {
            const response = await fetch(`${API_BASE}/api/admin/onboarding/statistics`, {
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });

            if (response.ok) {
                const data = await response.json();
                const stats = data.data;
                
                document.getElementById('statisticsContent').innerHTML = `
                    <div class="row g-4">
                        <div class="col-md-3">
                            <div class="text-center p-3" style="background: rgba(99, 102, 241, 0.05); border-radius: 12px;">
                                <div style="font-size: 32px; font-weight: 700; color: var(--primary-color);">${stats.totalUsersStarted}</div>
                                <div style="font-size: 14px; color: var(--text-secondary);">Users Started</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3" style="background: rgba(16, 185, 129, 0.05); border-radius: 12px;">
                                <div style="font-size: 32px; font-weight: 700; color: var(--success-color);">${stats.totalUsersCompleted}</div>
                                <div style="font-size: 14px; color: var(--text-secondary);">Users Completed</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3" style="background: rgba(245, 158, 11, 0.05); border-radius: 12px;">
                                <div style="font-size: 32px; font-weight: 700; color: var(--warning-color);">${stats.completionRate.toFixed(1)}%</div>
                                <div style="font-size: 14px; color: var(--text-secondary);">Completion Rate</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="text-center p-3" style="background: rgba(6, 182, 212, 0.05); border-radius: 12px;">
                                <div style="font-size: 32px; font-weight: 700; color: var(--info-color);">${stats.activeSteps}</div>
                                <div style="font-size: 14px; color: var(--text-secondary);">Active Steps</div>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4">
                        <h6 class="mb-3">Step-by-Step Statistics</h6>
                        <div class="table-responsive">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th>Step Name</th>
                                        <th>Started</th>
                                        <th>Completed</th>
                                        <th>Completion Rate</th>
                                        <th>Avg. Time</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    ${stats.stepStatistics.map(s => `
                                        <tr>
                                            <td>${s.stepName}</td>
                                            <td>${s.usersStarted}</td>
                                            <td>${s.usersCompleted}</td>
                                            <td><span class="badge bg-success">${s.completionRate.toFixed(1)}%</span></td>
                                            <td>${s.averageCompletionTime}</td>
                                        </tr>
                                    `).join('')}
                                </tbody>
                            </table>
                        </div>
                    </div>
                `;
                
                statisticsModal.show();
            }
        }

        let sortable = null;
        let isReorderMode = false;

        function reorderMode() {
            isReorderMode = !isReorderMode;
            const btn = document.getElementById('reorderBtn');
            const container = document.getElementById('stepsList');
            
            if (isReorderMode) {
                btn.innerHTML = '<i class="fas fa-save me-1"></i>Save Order';
                btn.classList.remove('btn-outline-primary');
                btn.classList.add('btn-success');
                
                // Enable drag and drop
                sortable = new Sortable(container, {
                    animation: 150,
                    handle: '.drag-handle',
                    ghostClass: 'sortable-ghost',
                    onEnd: function() {
                        // Update display order based on new positions
                        updateDisplayOrder();
                    }
                });
                
                showToast('Info', 'Drag and drop to reorder, then click Save Order', 'info');
            } else {
                btn.innerHTML = '<i class="fas fa-arrows-alt me-1"></i>Reorder Steps';
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-primary');
                
                if (sortable) {
                    sortable.destroy();
                    sortable = null;
                }
                
                // Save the new order
                saveStepOrder();
            }
        }

        function updateDisplayOrder() {
            const cards = document.querySelectorAll('.step-card');
            cards.forEach((card, index) => {
                const stepId = card.getAttribute('data-step-id');
                const step = currentSteps.find(s => s.id === stepId);
                if (step) {
                    step.displayOrder = index + 1;
                }
            });
        }

        async function saveStepOrder() {
            const orderData = {
                steps: currentSteps.map(step => ({
                    stepId: step.id,
                    displayOrder: step.displayOrder
                }))
            };

            const response = await fetch(`${API_BASE}/api/admin/onboarding/steps/reorder`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${JWT_TOKEN}`
                },
                body: JSON.stringify(orderData)
            });

            if (response.ok) {
                showToast('Success', 'Step order saved successfully', 'success');
                loadSteps();
            } else {
                showToast('Error', 'Failed to save step order', 'danger');
            }
        }

        function showToast(title, message, type) {
            // Simple toast notification
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} position-fixed top-0 end-0 m-3`;
            toast.style.zIndex = '9999';
            toast.innerHTML = `<strong>${title}:</strong> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
}
