@page
@model AppBackendBasic.AdminUI.Pages.Onboarding.QuestionsModel
@{
    ViewData["Title"] = "Manage Questions";
}

<style>
    .question-card {
        border-left: 4px solid var(--info-color);
        transition: all 0.3s ease;
    }
    .question-card:hover {
        transform: translateX(4px);
        box-shadow: var(--card-shadow-hover);
    }
    .question-card.inactive {
        opacity: 0.6;
        border-left-color: var(--text-secondary);
    }
    .type-badge {
        background: rgba(6, 182, 212, 0.1);
        color: var(--info-color);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }
    .drag-handle {
        cursor: move;
        color: var(--text-secondary);
        opacity: 0;
        transition: opacity 0.2s;
    }
    .question-card:hover .drag-handle {
        opacity: 1;
    }
    .action-btn {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: none;
        transition: all 0.2s;
    }
    .action-btn:hover {
        transform: scale(1.1);
    }
    .sortable-ghost {
        opacity: 0.4;
        background: #f8f9fa;
    }
</style>

<!-- Header with Back Button -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <a href="/Onboarding/Index" class="btn btn-outline-secondary btn-sm mb-2">
            <i class="fas fa-arrow-left me-2"></i>Back to Steps
        </a>
        <h2 class="mb-1" style="font-weight: 700; color: var(--text-primary);">
            <i class="fas fa-question-circle me-2" style="color: var(--info-color);"></i>
            Manage Questions
        </h2>
        <p class="text-muted mb-0" id="stepNameDisplay">Loading step information...</p>
    </div>
    <div>
        <button class="btn btn-primary" onclick="showCreateQuestionModal()" style="border-radius: 10px; padding: 10px 20px;">
            <i class="fas fa-plus me-2"></i>Add Question
        </button>
        <button class="btn btn-outline-secondary ms-2" onclick="reorderMode()" id="reorderBtn" style="border-radius: 10px; padding: 10px 20px;">
            <i class="fas fa-arrows-alt me-1"></i>Reorder Questions
        </button>
    </div>
</div>

<!-- Questions List -->
<div id="questionsList" class="row g-4">
    <!-- Questions will be loaded here -->
</div>

<!-- Create/Edit Question Modal -->
<div class="modal fade" id="questionModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="border-radius: 16px; border: none;">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--info-color), var(--primary-color)); color: white;">
                <h5 class="modal-title" id="questionModalTitle">
                    <i class="fas fa-plus-circle me-2"></i>Create Question
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <form id="questionForm">
                    <input type="hidden" id="questionId">
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="questionKey" class="form-label">Question Key *</label>
                            <input type="text" class="form-control" id="questionKey" required placeholder="e.g., full_name">
                            <small class="text-muted">Unique identifier (lowercase, underscores only)</small>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="questionType" class="form-label">Question Type *</label>
                            <select class="form-select" id="questionType" required onchange="handleTypeChange()">
                                <option value="">Select type...</option>
                                <option value="text">Text (Single Line)</option>
                                <option value="textarea">Text Area (Multi-line)</option>
                                <option value="email">Email</option>
                                <option value="phone">Phone Number</option>
                                <option value="date">Date</option>
                                <option value="number">Number</option>
                                <option value="select">Select (Dropdown)</option>
                                <option value="multiselect">Multi-select</option>
                                <option value="boolean">Boolean (Yes/No)</option>
                                <option value="radio">Radio Buttons</option>
                                <option value="timezone">Timezone</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="questionText" class="form-label">Question Text *</label>
                        <input type="text" class="form-control" id="questionText" required placeholder="What's your full name?">
                    </div>

                    <div class="mb-3">
                        <label for="placeholder" class="form-label">Placeholder Text</label>
                        <input type="text" class="form-control" id="placeholder" placeholder="Enter placeholder text...">
                    </div>

                    <div class="mb-3" id="optionsSection" style="display: none;">
                        <label for="options" class="form-label">Options (JSON Format) *</label>
                        <textarea class="form-control" id="options" rows="4" placeholder='[{"value": "option1", "label": "Option 1"}, {"value": "option2", "label": "Option 2"}]'></textarea>
                        <small class="text-muted">Required for select, multiselect, and radio types</small>
                    </div>

                    <div class="mb-3">
                        <label for="validationRules" class="form-label">Validation Rules (JSON Format)</label>
                        <textarea class="form-control" id="validationRules" rows="3" placeholder='{"minLength": 2, "maxLength": 100, "required": true}'></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="displayOrder" class="form-label">Display Order *</label>
                            <input type="number" class="form-control" id="displayOrder" required min="1" value="1">
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Required?</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isRequired" checked>
                                <label class="form-check-label" for="isRequired">Yes</label>
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Active?</label>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="isActive" checked>
                                <label class="form-check-label" for="isActive">Yes</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveQuestion()">
                    <i class="fas fa-save me-2"></i>Save Question
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.0/Sortable.min.js"></script>
    <script>
        const API_BASE = '@Model.ApiBaseUrl';
        const JWT_TOKEN = '@Model.JwtToken';
        const STEP_ID = '@Model.StepId';
        let currentQuestions = [];
        let questionModal;

        document.addEventListener('DOMContentLoaded', function() {
            questionModal = new bootstrap.Modal(document.getElementById('questionModal'));
            loadStepInfo();
            loadQuestions();
        });

        async function loadStepInfo() {
            const response = await fetch(`${API_BASE}/api/admin/onboarding/steps/${STEP_ID}`, {
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });
            
            if (response.ok) {
                const data = await response.json();
                document.getElementById('stepNameDisplay').textContent = `Step: ${data.data.stepName}`;
            }
        }

        async function loadQuestions() {
            const response = await fetch(`${API_BASE}/api/admin/onboarding/steps/${STEP_ID}/questions?includeInactive=true`, {
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });
            
            if (response.ok) {
                const data = await response.json();
                currentQuestions = data.data;
                renderQuestions(currentQuestions);
            }
        }

        function renderQuestions(questions) {
            const container = document.getElementById('questionsList');
            if (questions.length === 0) {
                container.innerHTML = `
                    <div class="col-12">
                        <div class="card text-center p-5">
                            <i class="fas fa-question-circle fa-4x text-muted mb-3"></i>
                            <h5>No Questions Yet</h5>
                            <p class="text-muted">Add your first question to this onboarding step</p>
                            <button class="btn btn-primary mt-2" onclick="showCreateQuestionModal()">
                                <i class="fas fa-plus me-2"></i>Add Question
                            </button>
                        </div>
                    </div>
                `;
                return;
            }

            container.innerHTML = questions.map(q => `
                <div class="col-12">
                    <div class="card question-card ${!q.isActive ? 'inactive' : ''}" data-question-id="${q.id}">
                        <div class="card-body">
                            <div class="d-flex align-items-start">
                                <div class="drag-handle me-3">
                                    <i class="fas fa-grip-vertical fa-lg"></i>
                                </div>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <h5 class="mb-1" style="font-weight: 600;">
                                                ${q.questionText}
                                                ${!q.isActive ? '<span class="badge bg-secondary ms-2">Inactive</span>' : ''}
                                                ${q.isRequired ? '<span class="badge bg-warning ms-2">Required</span>' : ''}
                                            </h5>
                                            <small class="text-muted">Key: ${q.questionKey} | Order: ${q.displayOrder}</small>
                                        </div>
                                        <span class="type-badge">${q.questionType}</span>
                                    </div>
                                    ${q.placeholder ? `<p class="text-muted mb-2" style="font-size: 13px;"><i class="fas fa-info-circle me-1"></i>Placeholder: ${q.placeholder}</p>` : ''}
                                    <div class="d-flex gap-2">
                                        <button class="action-btn" style="background: rgba(16, 185, 129, 0.1); color: var(--success-color);" 
                                                onclick="editQuestion('${q.id}')" title="Edit Question">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                        <button class="action-btn" style="background: rgba(239, 68, 68, 0.1); color: var(--danger-color);" 
                                                onclick="deleteQuestion('${q.id}')" title="Delete Question">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function handleTypeChange() {
            const type = document.getElementById('questionType').value;
            const optionsSection = document.getElementById('optionsSection');
            
            if (type === 'select' || type === 'multiselect' || type === 'radio') {
                optionsSection.style.display = 'block';
            } else {
                optionsSection.style.display = 'none';
            }
        }

        function showCreateQuestionModal() {
            document.getElementById('questionModalTitle').innerHTML = '<i class="fas fa-plus-circle me-2"></i>Create Question';
            document.getElementById('questionForm').reset();
            document.getElementById('questionId').value = '';
            document.getElementById('isRequired').checked = true;
            document.getElementById('isActive').checked = true;
            document.getElementById('optionsSection').style.display = 'none';
            questionModal.show();
        }

        async function editQuestion(questionId) {
            const question = currentQuestions.find(q => q.id === questionId);
            if (!question) return;

            document.getElementById('questionModalTitle').innerHTML = '<i class="fas fa-edit me-2"></i>Edit Question';
            document.getElementById('questionId').value = question.id;
            document.getElementById('questionKey').value = question.questionKey;
            document.getElementById('questionType').value = question.questionType;
            document.getElementById('questionText').value = question.questionText;
            document.getElementById('placeholder').value = question.placeholder || '';
            document.getElementById('options').value = question.options || '';
            document.getElementById('validationRules').value = question.validationRules || '';
            document.getElementById('displayOrder').value = question.displayOrder;
            document.getElementById('isRequired').checked = question.isRequired;
            document.getElementById('isActive').checked = question.isActive;
            
            handleTypeChange();
            questionModal.show();
        }

        async function saveQuestion() {
            const questionId = document.getElementById('questionId').value;
            const isEdit = questionId !== '';
            
            const questionData = {
                onboardingStepId: STEP_ID,
                questionKey: document.getElementById('questionKey').value,
                questionType: document.getElementById('questionType').value,
                questionText: document.getElementById('questionText').value,
                placeholder: document.getElementById('placeholder').value || null,
                options: document.getElementById('options').value || null,
                validationRules: document.getElementById('validationRules').value || null,
                displayOrder: parseInt(document.getElementById('displayOrder').value),
                isRequired: document.getElementById('isRequired').checked,
                isActive: document.getElementById('isActive').checked
            };

            if (isEdit) {
                questionData.id = questionId;
            }

            const url = isEdit 
                ? `${API_BASE}/api/admin/onboarding/questions/${questionId}`
                : `${API_BASE}/api/admin/onboarding/questions`;
            
            const method = isEdit ? 'PUT' : 'POST';

            const response = await fetch(url, {
                method: method,
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${JWT_TOKEN}`
                },
                body: JSON.stringify(questionData)
            });

            if (response.ok) {
                questionModal.hide();
                loadQuestions();
                showToast('Success', `Question ${isEdit ? 'updated' : 'created'} successfully`, 'success');
            } else {
                const error = await response.json();
                showToast('Error', error.message || 'Failed to save question', 'danger');
            }
        }

        async function deleteQuestion(questionId) {
            if (!confirm('Are you sure you want to delete this question? This will soft-delete it.')) return;

            const response = await fetch(`${API_BASE}/api/admin/onboarding/questions/${questionId}`, {
                method: 'DELETE',
                headers: { 'Authorization': `Bearer ${JWT_TOKEN}` }
            });

            if (response.ok) {
                loadQuestions();
                showToast('Success', 'Question deleted successfully', 'success');
            } else {
                showToast('Error', 'Failed to delete question', 'danger');
            }
        }

        let sortable = null;
        let isReorderMode = false;

        function reorderMode() {
            isReorderMode = !isReorderMode;
            const btn = document.getElementById('reorderBtn');
            const container = document.getElementById('questionsList');
            
            if (isReorderMode) {
                btn.innerHTML = '<i class="fas fa-save me-1"></i>Save Order';
                btn.classList.remove('btn-outline-secondary');
                btn.classList.add('btn-success');
                
                // Enable drag and drop
                sortable = new Sortable(container, {
                    animation: 150,
                    handle: '.drag-handle',
                    ghostClass: 'sortable-ghost',
                    onEnd: function() {
                        updateDisplayOrder();
                    }
                });
                
                showToast('Info', 'Drag and drop to reorder, then click Save Order', 'info');
            } else {
                btn.innerHTML = '<i class="fas fa-arrows-alt me-1"></i>Reorder Questions';
                btn.classList.remove('btn-success');
                btn.classList.add('btn-outline-secondary');
                
                if (sortable) {
                    sortable.destroy();
                    sortable = null;
                }
                
                saveQuestionOrder();
            }
        }

        function updateDisplayOrder() {
            const cards = document.querySelectorAll('.question-card');
            cards.forEach((card, index) => {
                const questionId = card.getAttribute('data-question-id');
                const question = currentQuestions.find(q => q.id === questionId);
                if (question) {
                    question.displayOrder = index + 1;
                }
            });
        }

        async function saveQuestionOrder() {
            const orderData = {
                questions: currentQuestions.map(q => ({
                    questionId: q.id,
                    displayOrder: q.displayOrder
                }))
            };

            const response = await fetch(`${API_BASE}/api/admin/onboarding/steps/${STEP_ID}/questions/reorder`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Authorization': `Bearer ${JWT_TOKEN}`
                },
                body: JSON.stringify(orderData)
            });

            if (response.ok) {
                showToast('Success', 'Question order saved successfully', 'success');
                loadQuestions();
            } else {
                showToast('Error', 'Failed to save question order', 'danger');
            }
        }

        function showToast(title, message, type) {
            const toast = document.createElement('div');
            toast.className = `alert alert-${type} position-fixed top-0 end-0 m-3`;
            toast.style.zIndex = '9999';
            toast.innerHTML = `<strong>${title}:</strong> ${message}`;
            document.body.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }
    </script>
}
