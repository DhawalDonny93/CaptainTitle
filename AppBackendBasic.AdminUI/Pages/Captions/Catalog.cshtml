@page "{kind}"
@model AppBackendBasic.AdminUI.Pages.Captions.CatalogModel
@using AppBackendBasic.AdminUI.Pages.Captions
@using Newtonsoft.Json.Linq
@{
    ViewData["Title"] = Model.Kind.Title;
}

<div class="container-fluid">
    @if (Model.SuccessMessage != null) { <div class="alert alert-success alert-dismissible fade show">@Model.SuccessMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
    @if (Model.ErrorMessage != null) { <div class="alert alert-danger alert-dismissible fade show">@Model.ErrorMessage<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-1">@Model.Kind.Title</h2>
            <p class="text-muted mb-0">@Model.Kind.Description</p>
        </div>
        <div>
            <a asp-page="Index" class="btn btn-outline-secondary me-2">Captain Title home</a>
            <button class="btn btn-primary" onclick="openEditor(null)"><i class="fas fa-plus me-2"></i>Add</button>
        </div>
    </div>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr>
                    @foreach (var f in Model.Kind.Fields.Where(f => f.InTable)) { <th>@f.Label</th> }
                    <th class="text-end">Actions</th>
                </tr></thead>
                <tbody>
                @foreach (var row in Model.Rows.OfType<JObject>())
                {
                    <tr>
                        @foreach (var f in Model.Kind.Fields.Where(f => f.InTable))
                        {
                            var v = row[f.Name];
                            <td>
                                @if (f.Type == FieldType.Bool) { <span class="badge @((v?.Value<bool>() ?? false) ? "bg-success" : "bg-secondary")">@((v?.Value<bool>() ?? false) ? "Yes" : "No")</span> }
                                else if (f.Type == FieldType.Color && v != null && v.Type != JTokenType.Null) { <span class="d-inline-block border rounded me-1" style="width:14px;height:14px;background:@v"></span>@v }
                                else { @(v == null || v.Type == JTokenType.Null ? "—" : v.ToString()) }
                            </td>
                        }
                        <td class="text-end text-nowrap">
                            <button class="btn btn-sm btn-outline-primary" data-row="@row.ToString(Newtonsoft.Json.Formatting.None)" onclick="openEditor(JSON.parse(this.dataset.row))">Edit</button>
                            <form method="post" asp-page-handler="Delete" asp-route-kind="@Model.Kind.Slug" asp-route-id="@row["id"]" class="d-inline" onsubmit="return confirm('Delete this item? Items in use cannot be deleted - deactivate them instead.');">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Rows.Any())
                {
                    <tr><td colspan="99" class="text-center text-muted py-4">Nothing here yet. Run Database_Migrations/21_captain_title_captions.sql to load the factory defaults.</td></tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="editorModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <form method="post" asp-page-handler="Save" asp-route-kind="@Model.Kind.Slug" class="modal-content">
            <input type="hidden" name="id" id="editorId" />
            <div class="modal-header"><h5 class="modal-title" id="editorTitle">Edit</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
            <div class="modal-body">
                <div class="row g-3">
                @foreach (var f in Model.Kind.Fields)
                {
                    <div class="@(f.Type == FieldType.Json ? "col-12" : "col-md-6")">
                        @if (f.Type == FieldType.Bool)
                        {
                            <div class="form-check form-switch mt-4">
                                <input class="form-check-input" type="checkbox" name="f_@f.Name" id="f_@f.Name" value="true" />
                                <label class="form-check-label" for="f_@f.Name">@f.Label</label>
                            </div>
                        }
                        else
                        {
                            <label class="form-label" for="f_@f.Name">@f.Label @(f.Required ? "*" : "")</label>
                            @if (f.Type == FieldType.Json) { <textarea class="form-control font-monospace" rows="4" name="f_@f.Name" id="f_@f.Name"></textarea> }
                            else if (f.Type == FieldType.Select)
                            {
                                <select class="form-select" name="f_@f.Name" id="f_@f.Name">
                                    @foreach (var o in f.Options ?? Array.Empty<string>()) { <option value="@o">@o</option> }
                                </select>
                            }
                            else if (f.Type == FieldType.Number) { <input class="form-control" type="number" step="any" name="f_@f.Name" id="f_@f.Name" /> }
                            else { <input class="form-control" type="text" name="f_@f.Name" id="f_@f.Name" placeholder="@(f.Type == FieldType.Color ? "#RRGGBB" : "")" /> }
                            @if (f.Help != null) { <div class="form-text">@f.Help</div> }
                        }
                    </div>
                }
                </div>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary">Save</button></div>
        </form>
    </div>
</div>

@section Scripts {
<script>
    const fields = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.Kind.Fields.Select(f => new { f.Name, Type = f.Type.ToString() })));
    function openEditor(row) {
        document.getElementById('editorId').value = row ? row.id : '';
        document.getElementById('editorTitle').textContent = row ? 'Edit' : 'Add';
        fields.forEach(f => {
            const el = document.getElementById('f_' + f.Name);
            if (!el) return;
            const v = row ? row[f.Name] : null;
            if (f.Type === 'Bool') el.checked = row ? !!v : (f.Name === 'isActive');
            else el.value = v === null || v === undefined ? '' : (typeof v === 'object' ? JSON.stringify(v) : v);
        });
        new bootstrap.Modal(document.getElementById('editorModal')).show();
    }
</script>
}
