@* Reusable Confirmation Modal Component *@

<div class="modal fade" id="confirmationModal" tabindex="-1" aria-labelledby="confirmationModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmationModalLabel">Confirm Action</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex align-items-start">
                    <i class="bi bi-exclamation-triangle-fill text-warning fs-2 me-3" id="confirmationModalIcon"></i>
                    <div>
                        <p class="mb-0" id="confirmationModalMessage">Are you sure you want to proceed with this action?</p>
                        <small class="text-muted" id="confirmationModalSubtext"></small>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmationModalConfirm">Confirm</button>
            </div>
        </div>
    </div>
</div>

<script>
    // Global confirmation dialog function
    function showConfirmation(options) {
        const defaults = {
            title: 'Confirm Action',
            message: 'Are you sure you want to proceed?',
            subtext: '',
            confirmText: 'Confirm',
            confirmClass: 'btn-danger',
            icon: 'bi-exclamation-triangle-fill',
            iconClass: 'text-warning',
            onConfirm: null
        };

        const settings = { ...defaults, ...options };

        // Update modal content
        document.getElementById('confirmationModalLabel').textContent = settings.title;
        document.getElementById('confirmationModalMessage').textContent = settings.message;
        document.getElementById('confirmationModalSubtext').textContent = settings.subtext;

        // Update icon
        const icon = document.getElementById('confirmationModalIcon');
        icon.className = `bi ${settings.icon} ${settings.iconClass} fs-2 me-3`;

        // Update confirm button
        const confirmBtn = document.getElementById('confirmationModalConfirm');
        confirmBtn.textContent = settings.confirmText;
        confirmBtn.className = `btn ${settings.confirmClass}`;

        // Remove old event listeners by cloning
        const newConfirmBtn = confirmBtn.cloneNode(true);
        confirmBtn.parentNode.replaceChild(newConfirmBtn, confirmBtn);

        // Add new event listener
        newConfirmBtn.addEventListener('click', function() {
            if (settings.onConfirm && typeof settings.onConfirm === 'function') {
                settings.onConfirm();
            }
            bootstrap.Modal.getInstance(document.getElementById('confirmationModal')).hide();
        });

        // Show modal
        const modal = new bootstrap.Modal(document.getElementById('confirmationModal'));
        modal.show();
    }

    // Convenience functions for common confirmation types
    function confirmDelete(itemName, onConfirm) {
        showConfirmation({
            title: 'Delete ' + itemName,
            message: 'Are you sure you want to delete this ' + itemName.toLowerCase() + '?',
            subtext: 'This action cannot be undone.',
            confirmText: 'Delete',
            confirmClass: 'btn-danger',
            icon: 'bi-trash-fill',
            iconClass: 'text-danger',
            onConfirm: onConfirm
        });
    }

    function confirmAction(actionName, message, onConfirm) {
        showConfirmation({
            title: actionName,
            message: message,
            confirmText: 'Proceed',
            confirmClass: 'btn-primary',
            icon: 'bi-info-circle-fill',
            iconClass: 'text-primary',
            onConfirm: onConfirm
        });
    }

    function confirmDanger(title, message, onConfirm) {
        showConfirmation({
            title: title,
            message: message,
            subtext: 'This action may have significant consequences.',
            confirmText: 'I Understand',
            confirmClass: 'btn-danger',
            icon: 'bi-exclamation-octagon-fill',
            iconClass: 'text-danger',
            onConfirm: onConfirm
        });
    }
</script>

<style>
    #confirmationModal .modal-body {
        padding: 1.5rem;
    }

    #confirmationModal .modal-body i {
        flex-shrink: 0;
    }

    #confirmationModal .modal-footer {
        border-top: 1px solid #dee2e6;
        padding: 1rem 1.5rem;
    }
</style>
