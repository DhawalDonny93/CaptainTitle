@model dynamic

@{
    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var pageUrl = ViewData["PageUrl"] as string ?? "";
    var showFirstLast = ViewData["ShowFirstLast"] as bool? ?? true;
    var maxVisiblePages = ViewData["MaxVisiblePages"] as int? ?? 5;

    int startPage = Math.Max(1, currentPage - maxVisiblePages / 2);
    int endPage = Math.Min(totalPages, startPage + maxVisiblePages - 1);
    
    if (endPage - startPage < maxVisiblePages - 1)
    {
        startPage = Math.Max(1, endPage - maxVisiblePages + 1);
    }
}

@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            @* First Page *@
            @if (showFirstLast && currentPage > 1)
            {
                <li class="page-item">
                    <a class="page-link" href="@(pageUrl)?page=1" aria-label="First">
                        <span aria-hidden="true">&laquo;&laquo;</span>
                    </a>
                </li>
            }

            @* Previous Page *@
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                @if (currentPage > 1)
                {
                    <a class="page-link" href="@(pageUrl)?page=@(currentPage - 1)" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </a>
                }
                else
                {
                    <span class="page-link" aria-label="Previous">
                        <span aria-hidden="true">&laquo;</span>
                    </span>
                }
            </li>

            @* Page Numbers *@
            @if (startPage > 1)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" href="@(pageUrl)?page=@i">@i</a>
                </li>
            }

            @if (endPage < totalPages)
            {
                <li class="page-item disabled">
                    <span class="page-link">...</span>
                </li>
            }

            @* Next Page *@
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                @if (currentPage < totalPages)
                {
                    <a class="page-link" href="@(pageUrl)?page=@(currentPage + 1)" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </a>
                }
                else
                {
                    <span class="page-link" aria-label="Next">
                        <span aria-hidden="true">&raquo;</span>
                    </span>
                }
            </li>

            @* Last Page *@
            @if (showFirstLast && currentPage < totalPages)
            {
                <li class="page-item">
                    <a class="page-link" href="@(pageUrl)?page=@totalPages" aria-label="Last">
                        <span aria-hidden="true">&raquo;&raquo;</span>
                    </a>
                </li>
            }
        </ul>
    </nav>

    <div class="text-center text-muted small mt-2">
        Page @currentPage of @totalPages
        @if (ViewData["TotalCount"] != null)
        {
            <span>(@ViewData["TotalCount"] total items)</span>
        }
    </div>
}

<style>
    .pagination {
        margin-top: 1rem;
        margin-bottom: 1rem;
    }

    .page-link {
        color: #FF2D4D;
        cursor: pointer;
    }

    .page-item.active .page-link {
        background-color: #FF2D4D;
        border-color: #FF2D4D;
        color: white;
    }

    .page-item.disabled .page-link {
        cursor: not-allowed;
    }
</style>
